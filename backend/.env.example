# ====================================================================
# PETPOOJA ERP — Environment Configuration
# Copy to .env and fill in your values
# ====================================================================

# Server
NODE_ENV=production
PORT=5001

# Database (PostgreSQL 16)
# For Supabase Session Pooler (IPv4), the username MUST be 'postgres.[project-id]'.
# IMPORTANT: set connection_limit so each backend instance caps its pool. Without
# it Prisma defaults to (num_cpus*2)+1 PER instance, which exhausts the Supabase
# pooler's connection cap under multi-instance (Render autoscale) load. Use a small
# value (3-5) and multiply by your max instance count to stay under the pooler limit.
DATABASE_URL=postgresql://postgres.mddgruyvajrmolbocdsp:[PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require

# Redis 7
# A REAL Redis here (not localhost/mock) enables the Socket.io Redis adapter so
# realtime events broadcast across multiple backend instances. With localhost/mock,
# the app runs single-instance (fine for dev / a single Render instance).
REDIS_URL=redis://:your_redis_password@localhost:6379

# Auth availability vs security tradeoff: when Redis is unreachable the token
# blacklist (logout/revocation) can't be checked. Default = fail CLOSED (reject,
# secure). Set to 'true' to fail OPEN (accept tokens, prioritise availability) if
# your prod Redis is flaky and you accept the ~15m revocation-bypass window.
AUTH_FAIL_OPEN_ON_REDIS_ERROR=false

# JWT (MINIMUM 256-bit secrets — generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_64_CHAR_HEX_STRING
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_DIFFERENT_64_CHAR_HEX_STRING
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Secrets-at-rest encryption (AES-256-GCM) for stored OAuth tokens, e.g. Xero
# access/refresh tokens. MUST be a 32-byte key as 64 hex chars (openssl rand -hex 32)
# or base64. REQUIRED in production — without it the app refuses to encrypt/decrypt
# stored secrets. In non-production it may be left blank (tokens stored unencrypted,
# with a loud warning). TOKEN_ENC_KEY is accepted as an alias.
SECRETS_ENC_KEY=

# CORS — allowed browser origins are an EXACT allowlist (no wildcards, no
# preview-URL patterns). The four first-party hosts are built in
# (petpooja-saas/petpooja-admin on Vercel + getmsrm.com.au/www). Add extra
# exact origins with CORS_ORIGINS, comma-separated. CORS_WHITELIST is still
# honoured as a legacy alias. Localhost is auto-allowed OUTSIDE production only.
CORS_ORIGINS=
CORS_WHITELIST=http://localhost:3001,http://localhost:3002

# Error monitoring (Sentry) — OPTIONAL. Leave SENTRY_DSN empty to disable
# entirely (the SDK is not even loaded). Set it to your project's DSN to
# report unhandled API errors. Tracing is off unless SENTRY_TRACES_SAMPLE_RATE
# is set (0..1). SENTRY_ENVIRONMENT defaults to NODE_ENV.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0

# Logging — production logs go to stdout (Render captures them); local-disk
# daily-rotate files are written only in dev. Set LOG_TO_FILE=true to force
# file logs in production (only useful with a persistent volume).
LOG_TO_FILE=false

# Bcrypt
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AUTH=5

# ── DATA RESIDENCY (AU) ──────────────────────────────────────────────────────
# All storage regions/buckets/hosts below are env-driven — nothing is hardcoded.
# For the AUSTRALIAN tenant, data at rest must live in Australia (APP 8):
#   DATABASE_URL            → a Supabase/Postgres project in ap-southeast-2 (Sydney)
#   AWS_REGION              → ap-southeast-2      SUPABASE_REGION → ap-southeast-2
#   AWS_S3_BUCKET / SUPABASE_STORAGE_BUCKET → a bucket in ap-southeast-2
#   BACKUP_S3_BUCKET (CI)   → also ap-southeast-2
# Render has no AU region; Singapore is nearest (compute in SG, data at rest in AU).
# Full cutover procedure: backend/docs/AU_DATA_RESIDENCY.md
# ─────────────────────────────────────────────────────────────────────────────

# AWS S3 (file uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=petpooja-uploads
AWS_CLOUDFRONT_URL=

# Supabase Storage (preferred over AWS S3 when configured — see config/storage.js)
SUPABASE_REGION=us-east-1
SUPABASE_STORAGE_BUCKET=uploads
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_ENDPOINT=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Pine Labs
PINELABS_MERCHANT_ID=
PINELABS_SECURITY_TOKEN=
PINELABS_STORE_ID=

# Aggregator Webhooks
SWIGGY_WEBHOOK_SECRET=
SWIGGY_API_URL=https://partner-api.swiggy.com
SWIGGY_API_KEY=
ZOMATO_WEBHOOK_SECRET=
ZOMATO_API_URL=https://api.zomato.com
ZOMATO_API_KEY=

# SMS (MSG91)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=PETPJA
MSG91_TEMPLATE_ID=
MSG91_OTP_TEMPLATE=

# WhatsApp Business API (Meta)
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Loyalty
LOYALTY_EARN_RATIO=100
LOYALTY_REDEEM_VALUE=1
LOYALTY_MIN_REDEEM=50
