---
// Pain points — the "problem" beat. Each pain is a before → after pair
// (the visual gap the audit flagged: no before/after treatment existed).
import Icon from '../Icon.astro';
import { PAINS } from '../../data/site';
---
<section class="container-x py-16 lg:py-24">
  <div class="text-center max-w-2xl mx-auto" data-reveal>
    <span class="eyebrow">Sound familiar?</span>
    <h2 class="h2 mt-2">The three things quietly costing you.</h2>
    <p class="lead mt-3">Most restaurants don't lose money on one big thing — they bleed it across a stack of disconnected tools. Here's where, and how one platform fixes it.</p>
  </div>

  <div class="mt-12 space-y-5">
    {PAINS.map((p, i) => (
      <div class="grid md:grid-cols-[auto_1fr_1fr] gap-4 md:gap-6 items-stretch reveal" data-reveal style={`--i:${i}`}>
        <!-- Label -->
        <div class="flex md:flex-col items-center md:items-start gap-3 md:w-44">
          <div class="feature-tile"><Icon name={p.icon} class="w-6 h-6" /></div>
          <h3 class="font-bold text-lg leading-tight">{p.title}</h3>
        </div>
        <!-- Before -->
        <div class="rounded-xl2 border border-red-200 bg-red-50/60 p-5">
          <div class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wide text-red-600 mb-2">
            <span class="grid h-4 w-4 place-items-center rounded-full bg-red-100 text-red-600">✕</span> Today
          </div>
          <p class="text-ink-soft text-[15px] leading-relaxed">{p.before}</p>
        </div>
        <!-- After -->
        <div class="rounded-xl2 border border-brand-200 bg-brand-50/60 p-5 relative">
          <div class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wide text-brand-700 mb-2">
            <Icon name="check" class="w-4 h-4 text-brand-600" /> With MSRM
          </div>
          <p class="text-ink-soft text-[15px] leading-relaxed">{p.after}</p>
        </div>
      </div>
    ))}
  </div>
</section>
