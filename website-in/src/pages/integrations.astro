---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
const cats = [
  { title: 'Aggregators', to: '/features/online-orders', items: ['Zomato', 'Swiggy'] },
  { title: 'Payments', to: '/features/pos', items: ['UPI', 'Razorpay', 'Cards', 'Cash'] },
  { title: 'Accounting', to: '/features/accounting', items: ['Tally', 'GST', 'GSTR-1 / GSTR-3B'] },
  { title: 'QR & self-order', to: '/features/online-orders', items: ['Table QR ordering', 'Takeaway QR'] },
  { title: 'Messaging', to: '/features/online-orders', items: ['WhatsApp'] },
];
---
<Layout title="Integrations" description="MSRM connects to the aggregators, payment gateways and accounting tools Indian restaurants already use — Zomato, Swiggy, UPI, Razorpay, Tally and GST.">
  <section class="container-x pt-16 pb-8 text-center max-w-2xl mx-auto">
    <span class="eyebrow">Integrations</span>
    <h1 class="h1 text-4xl sm:text-5xl mt-3">Plays well with your stack.</h1>
    <p class="lead mt-4">Connect the platforms you already run on — orders, payments and books flow into MSRM automatically.</p>
  </section>
  <section class="container-x grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {cats.map((c) => (
      <a href={c.to} class="card hover:border-brand-400 transition">
        <h3 class="font-semibold text-lg">{c.title}</h3>
        <div class="mt-3 flex flex-wrap gap-2">{c.items.map((i) => <span class="chip">{i}</span>)}</div>
      </a>
    ))}
  </section>
  <p class="container-x mt-6 text-sm text-ink-mute">Note: Zomato &amp; Swiggy connect through certified POS-partner middleware, and payments/accounting via their respective gateways — we set this up during onboarding. All trademarks belong to their respective owners.</p>
  <CTA />
</Layout>
